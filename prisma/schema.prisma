generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  hasPaid       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  leagues       League[]       @relation("LeagueOwner")
  leagueMembers LeagueMember[]
  payments      Payment[]
  predictions   Prediction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// TOURNAMENT DATA
// ─────────────────────────────────────────────

/// Selección / equipo participante del Mundial.
/// Separarlo de Match permite: banderas, estadísticas, puntos de grupo, etc.
model Team {
  id      String  @id @default(cuid())
  /// Nombre oficial FIFA (ej: "Argentina", "República Checa")
  name    String  @unique
  /// Código ISO 3166-1 alpha-2 para banderas (ej: "AR", "CZ")
  code    String  @unique // e.g. "ARG", "CZE" (FIFA 3-letter code)
  /// Grupo al que pertenece: "A"…"L". Null si es equipo placeholder TBD.
  group   String?
  /// URL de imagen de bandera (opcional, puede resolverse en frontend)
  flagUrl String?

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

/// Partido del Mundial. Cubre los 104 partidos completos.
model Match {
  id String @id @default(cuid())

  /// Número oficial FIFA del partido (1-104). Único e inmutable.
  matchNumber Int @unique

  /// ─── EQUIPOS ───────────────────────────────
  /// En fase de grupos: siempre populado con el Team real.
  /// En fase eliminatoria: populado con Team real una vez confirmado el clasificado,
  ///   hasta entonces es null y se usa homePlaceholder / awayPlaceholder.
  homeTeamId String?
  awayTeamId String?

  homeTeam Team? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team? @relation("AwayTeam", fields: [awayTeamId], references: [id])

  /// ─── PLACEHOLDERS (fase eliminatoria) ──────
  /// Descripción legible del clasificado pendiente.
  /// Ej: "1° Grupo A", "2° Grupo B", "Mejor 3° C/D/E/F", "Ganador Partido 73"
  /// Null en fase de grupos y null cuando el equipo ya está confirmado.
  homePlaceholder String?
  awayPlaceholder String?

  /// ─── RESULTADO ──────────────────────────────
  homeScore     Int?
  awayScore     Int?
  /// Resultado en penales (solo para eliminatorias)
  homePenalties Int?
  awayPenalties Int?

  /// ─── UBICACIÓN ──────────────────────────────
  venue         String?
  city          String?
  /// Timezone IANA del estadio (ej: "America/New_York", "America/Mexico_City")
  venueTimezone String?

  /// ─── PROGRAMACIÓN ───────────────────────────
  /// Almacenado siempre en UTC. Mostrar en frontend como UTC-3 (Argentina).
  matchDate DateTime

  /// Cierre de predicciones. Default: 1 hora antes del partido.
  /// También en UTC.
  predictionsDeadline DateTime

  /// ─── CLASIFICACIÓN TORNENO ──────────────────
  /// "A"…"L" para fase de grupos, null en eliminatorias.
  group String?

  stage MatchStage @default(GROUP)

  /// ─── ESTADO ─────────────────────────────────
  status MatchStatus @default(SCHEDULED)

  /// ─── BRACKET (fase eliminatoria) ────────────
  /// Referencia al partido del que viene el equipo local en bracket.
  /// Ej: Match 89 homeTeam = winner of Match 74.
  homeSourceMatchId String?
  awaySourceMatchId String?
  homeSourceResult  MatchResult? // WINNER | LOSER (para 3er puesto)
  awaySourceResult  MatchResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]
}

// ─────────────────────────────────────────────
// PRODE / LEAGUES
// ─────────────────────────────────────────────

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeGoals Int
  awayGoals Int
  /// Puntos otorgados post-resultado. 0 hasta que se liquide.
  points    Int      @default(0)
  /// true cuando el partido terminó y los puntos fueron calculados
  scored    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}

model League {
  id        String     @id @default(cuid())
  name      String
  type      LeagueType
  code      String     @unique
  ownerId   String
  createdAt DateTime   @default(now())

  owner   User           @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members LeagueMember[]
}

model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  joinedAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  mpPaymentId String        @unique
  status      PaymentStatus @default(PENDING)
  amount      Float
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum MatchStage {
  GROUP
  ROUND_OF_32 // dieciseisavos — NUEVO en 2026
  ROUND_OF_16 // octavos
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED // por si acaso
}

enum MatchResult {
  WINNER
  LOSER
}

enum LeagueType {
  GENERAL_PAID
  PRIVATE_FREE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}
